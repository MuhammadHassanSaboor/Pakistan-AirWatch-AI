# ─────────────────────────────────────────────────────────────
# SECRETS — never commit these. This repo is PUBLIC.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
*_secret*
*token*
!**/tokenizer*
.aws/
.oci/
config.local.*
.dvc/config.local
.dvc/tmp
.dvc/cache

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Virtual envs (we use conda, but just in case). Anchored for the
# same reason as above: a bare `env/` would match src/env/ too.
/.venv/
/venv/
/env/

# ─────────────────────────────────────────────────────────────
# Data — tracked by DVC, never by Git
# ─────────────────────────────────────────────────────────────
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/**/*.dvc
# data/reference/ IS committed (small CSV city list)

*.parquet
*.feather
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3

# ─────────────────────────────────────────────────────────────
# Models & artifacts
# ─────────────────────────────────────────────────────────────
# NOTE the leading slash. An unanchored `models/` matches a directory
# called "models" at ANY depth, which silently excluded the entire
# src/models/ source package from the repository. Anchor every
# generated-output directory to the repo root.
/models/
*.pkl
*.joblib
*.onnx
*.pt
*.pth
/mlruns/
/mlartifacts/
/.mlflow/
/bentoml/

# ─────────────────────────────────────────────────────────────
# Reports (generated)
# ─────────────────────────────────────────────────────────────
reports/*
!reports/.gitkeep
!reports/*.md

# The three files dvc.yaml declares as `metrics: cache: false` are a
# deliberate exception. `cache: false` means DVC does NOT store them --
# it expects Git to, which is what makes `dvc metrics diff <rev>` able
# to compare a run against an earlier commit. Ignoring them left the
# metrics out of history entirely and that command with nothing to read.
# They are small, plain JSON, and contain no credentials.
!reports/data_quality.json
!reports/feature_summary.json
!reports/train_metrics.json

# ─────────────────────────────────────────────────────────────
# Feature store (generated state)
# ─────────────────────────────────────────────────────────────
feature_store/feature_repo/data/
feature_store/**/registry.db
feature_store/**/online_store.db

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.local

# ─────────────────────────────────────────────────────────────
# Airflow
# ─────────────────────────────────────────────────────────────
pipelines/airflow/logs/
airflow.db
airflow.cfg
webserver_config.py
standalone_admin_password.txt

# ─────────────────────────────────────────────────────────────
# OS / editor
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~

# ─────────────────────────────────────────────────────────────
# Local editor / assistant tooling (per-developer, not the project)
# ─────────────────────────────────────────────────────────────
.claude/
