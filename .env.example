# ═══════════════════════════════════════════════════════════════
# Pakistan AirWatch AI — environment template
#
#   1. Copy this file to  .env
#   2. Fill in YOUR OWN values
#   3. NEVER commit .env   (it is in .gitignore)
#
# This repository is PUBLIC. Anything written in .env.example is
# visible to the world, so only placeholder text goes here.
# ═══════════════════════════════════════════════════════════════

# ── MLflow on DagsHub (our shared experiment server) ──────────
# Find these on your DagsHub repo page -> green "Remote" button -> MLflow tab.
# Username = your DagsHub username.
# Password = a personal access token (DagsHub -> Settings -> Tokens).
# Each team member uses their OWN token. Never share one.
MLFLOW_TRACKING_URI=https://dagshub.com/MuhammadHassanSaboor/Pakistan-AirWatch-AI.mlflow
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
MLFLOW_EXPERIMENT_NAME=pm25-forecasting

# Which team member is running this training job?
# Used to tag MLflow runs so we can compare per person.
# One of: hassan | mudassar | ifraz
AIRWATCH_MEMBER=hassan

# ── DVC remote (same DagsHub token) ───────────────────────────
DAGSHUB_USER_TOKEN=your-dagshub-token

# ── Data sources ──────────────────────────────────────────────
# Open-Meteo needs NO key at all. Nothing to set.
#
# OpenAQ is OPTIONAL (only for ground-truth validation).
# Leave blank and the pipeline skips it automatically.
OPENAQ_API_KEY=

# ── Database (runs in Docker) ─────────────────────────────────
POSTGRES_USER=airwatch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=airwatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Flask API ─────────────────────────────────────────────────
FLASK_ENV=development
API_HOST=0.0.0.0
# 5001, not 5000. Port 5000 is heavily contested: Docker port relays,
# other local projects and macOS AirPlay all claim it, and when one
# does the symptom is confusing -- the frontend reaches *something*
# that answers /health but 404s every other route.
# Containers still listen on 5000 internally; this is the HOST port.
API_PORT=5001
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Where the API loads its model from.
#   registry -> MLflow Model Registry (needs the MLflow vars above)
#   local    -> models/production/model.pkl  (works offline)
MODEL_SOURCE=local
MODEL_NAME=pm25-forecaster
MODEL_STAGE=Production
LOCAL_MODEL_PATH=models/production

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-locally
