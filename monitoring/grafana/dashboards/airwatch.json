{
  "uid": "airwatch-main",
  "title": "Pakistan AirWatch AI — Service Health",
  "tags": ["airwatch", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service status",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"airwatch-api\"}", "refId": "A", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [
        { "expr": "sum(rate(flask_http_request_total[5m]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "#0F766E" } }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(flask_http_request_total[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Model version in production",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [
        {
          "expr": "airwatch_model_version_info",
          "refId": "A",
          "legendFormat": "v{{version}} ({{algorithm}})"
        }
      ],
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "name" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Upstream data age",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        { "expr": "airwatch_upstream_data_age_seconds", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 7200 },
              { "color": "red", "value": 10800 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Prediction latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(airwatch_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "A", "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(airwatch_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "B", "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(airwatch_prediction_latency_seconds_bucket[5m])) by (le))",
          "refId": "C", "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Predictions served per second, by horizon",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(airwatch_predictions_total[5m])) by (horizon)",
          "refId": "A", "legendFormat": "+{{horizon}}h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" }, "showPoints": "never" }
        }
      }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Predicted PM2.5 distribution — drift early warning",
      "description": "A sustained shift in this distribution without a matching change in observations suggests model drift. Investigate with the Evidently report.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(airwatch_predicted_pm25_ugm3_bucket[30m])) by (le))",
          "refId": "A", "legendFormat": "median"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(airwatch_predicted_pm25_ugm3_bucket[30m])) by (le))",
          "refId": "B", "legendFormat": "p90"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "conµg/m3",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 55 },
              { "color": "red", "value": 150 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Data-quality failures per hour",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "increase(airwatch_data_quality_failures_total[1h])",
          "refId": "A", "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 25, "drawStyle": "bars" }
        }
      }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total[5m])) by (endpoint)",
          "refId": "A", "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Responses by HTTP status",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total[5m])) by (status)",
          "refId": "A", "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      }
    }
  ]
}
